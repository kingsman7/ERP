rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isValidBackup(data) {
      return data.id is string &&
             data.backupCode is string &&
             data.name is string &&
             data.type in ['MANUAL', 'SCHEDULED', 'AUTOMATIC', 'PRE_RESTORE'] &&
             data.status in ['COMPLETED', 'IN_PROGRESS', 'FAILED', 'RESTORED'] &&
             data.createdAt is string &&
             data.createdBy is string &&
             data.sizeBytes is number &&
             data.checksumSha256 is string &&
             data.totalCollections is number &&
             data.totalRecords is number &&
             data.storageTarget in ['FIRESTORE_CLOUD', 'LOCAL_DOWNLOAD', 'HYBRID'] &&
             data.erpVersion is string;
    }

    function isValidBackupSchedule(data) {
      return data.id is string &&
             data.enabled is bool &&
             data.frequency in ['HOURLY', 'EVERY_6_HOURS', 'EVERY_12_HOURS', 'DAILY', 'WEEKLY', 'CUSTOM_MINUTES'] &&
             data.customIntervalMinutes is number &&
             data.autoSyncToFirestore is bool &&
             data.autoDownloadJson is bool &&
             data.maxBackupsToRetain is number;
    }

    function isValidDispatchGuide(data) {
      return data.id is string &&
             data.guideNumber is string &&
             data.controlNumber is string &&
             data.issueDate is string &&
             data.status in ['BORRADOR', 'EN_TRANSITO', 'EMITIDA', 'ENTREGADA', 'FACTURADA', 'ANULADA'] &&
             data.originWarehouseId is string &&
             data.customerId is string &&
             data.transferReason in ['VENTA', 'TRASLADO_ALMACEN', 'CONSIGNACION', 'DEVOLUCION', 'DEMOSTRACION', 'REPARACION_GARANTIA', 'OTRO'] &&
             data.carrierName is string &&
             data.driverName is string &&
             data.driverIdNumber is string &&
             data.vehiclePlate is string;
    }

    function isValidDeliveryOrder(data) {
      return data.id is string &&
             data.orderNumber is string &&
             data.controlNumber is string &&
             data.customerId is string &&
             data.deliveryAddress is string &&
             data.warehouseId is string &&
             data.issueDate is string &&
             data.status in ['PENDIENTE_DESPACHO', 'EN_RUTA', 'ENTREGADA_CONFORME', 'ENTREGADA_CON_NOVEDAD', 'FACTURADA', 'ANULADA'];
    }

    // ERP Backups Collection
    match /erp_backups/{backupId} {
      allow read: if true;
      allow create: if isValidBackup(request.resource.data);
      allow update: if isValidBackup(request.resource.data);
      allow delete: if true;
    }

    // ERP Backup Schedules Collection
    match /erp_backup_schedules/{scheduleId} {
      allow read: if true;
      allow create: if isValidBackupSchedule(request.resource.data);
      allow update: if isValidBackupSchedule(request.resource.data);
      allow delete: if true;
    }

    // Dispatch Guides Collection
    match /dispatch_guides/{guideId} {
      allow read: if true;
      allow create: if isValidDispatchGuide(request.resource.data);
      allow update: if isValidDispatchGuide(request.resource.data);
      allow delete: if true;
    }

    // Delivery Orders Collection
    match /delivery_orders/{orderId} {
      allow read: if true;
      allow create: if isValidDeliveryOrder(request.resource.data);
      allow update: if isValidDeliveryOrder(request.resource.data);
      allow delete: if true;
    }
  }
}
